    "next": "14.2.32",
    "next-auth": "^4.24.11",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.64.0",
    "recharts": "^2.15.4",
    "resend": "^4.3.1",
