# ---- Database ----
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/localreach?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/localreach?schema=public"

# ---- Auth ----
AUTH_SECRET="generate-a-long-random-secret"
NEXTAUTH_URL="https://yourdomain.com"
NEXTAUTH_SECRET="generate-a-long-random-secret"

# ---- App ----
NEXT_PUBLIC_APP_URL="https://yourdomain.com"

# ---- Google OAuth (optional) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Storage (S3-compatible: Cloudflare R2 / AWS S3 / Supabase Storage) ----
# Leave empty in development to use the built-in local dev storage adapter.
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_PUBLIC_BASE_URL=

# ---- Email (Resend). Leave empty to log emails to console in dev ----
RESEND_API_KEY=
EMAIL_FROM="LocalReach <no-reply@yourdomain.com>"

# ---- PayFast (South Africa). Leave empty to use the built-in mock provider ----
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_MODE="sandbox" # sandbox | live

# ---- Stripe (optional) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Automated moderation (optional external AI moderation API) ----
MODERATION_API_KEY=
MODERATION_API_URL=

# ---- Super admin bootstrap (used by the seed script) ----
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
